{
  "name": "VirtualShip Workspace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // TODO: point back to main when performance branch is merged into main
  "postCreateCommand": "pip install git+https://github.com/Parcels-code/virtualship.git@performance",
  // open the landing page on first attach
  "postAttachCommand": "[ -f ~/.virtualship-welcome-shown ] || { code .devcontainer/welcome.md && touch ~/.virtualship-welcome-shown; }",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": true,
        // render the landing page as a markdown preview rather than raw source
        "workbench.editorAssociations": {
          "welcome.md": "vscode.markdown.preview.editor"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteUser": "root"
}
