#!/usr/bin/env bash
set -e

CONFIG_FILE=".binder/config.yaml"

REPO_OWNER=$(grep '^repo_owner:' "$CONFIG_FILE" | awk '{print $2}' | tr -d '"')
REPO_NAME=$(grep '^repo_name:' "$CONFIG_FILE" | awk '{print $2}' | tr -d '"')
BRANCH=$(grep '^branch:' "$CONFIG_FILE" | awk '{print $2}' | tr -d '"')
LIST_FILE=$(grep '^files_to_fetch_path:' "$CONFIG_FILE" | awk '{print $2}' | tr -d '"')

ISSUES_URL="https://github.com/$REPO_OWNER/$REPO_NAME/issues"
TARGET_DIR="tutorials"

mkdir -p "$TARGET_DIR"

while IFS= read -r file_path || [ -n "$file_path" ]; do
  [[ -z "$file_path" || "$file_path" =~ ^# ]] && continue

  RAW_URL="https://raw.githubusercontent.com/$REPO_OWNER/$REPO_NAME/$BRANCH/$file_path"
  FILENAME=$(basename "$file_path")
  DEST_PATH="$TARGET_DIR/$FILENAME"

  echo "Fetching: $file_path -> $DEST_PATH ..."
  
  HTTP_STATUS=$(curl -s -w "%{http_code}" -o "$DEST_PATH" "$RAW_URL")
  
  if [ "$HTTP_STATUS" -ne 200 ]; then
    rm -f "$DEST_PATH"
    
    echo ""
    echo "=================================================================="
    echo " ERROR: Required file could not be found!"
    echo " Failed to download: $file_path (HTTP $HTTP_STATUS)"
    echo " URL attempted: $RAW_URL"
    echo ""
    echo " Please report this broken build on the VirtualShip issue tracker:"
    echo " -> $ISSUES_URL"
    echo "=================================================================="
    echo ""
    
    exit 1
  fi
done < "$LIST_FILE"

# landing page: copy to the workspace root (Jupyter hides dot-directories such as .binder/)
cp .binder/preview.md preview.md

# open markdown files as rendered previews (rather than raw source) in JupyterLab
LAB_SETTINGS_DIR="$(jupyter lab path | awk -F': *' '/Application directory/ {print $2}')/settings"
mkdir -p "$LAB_SETTINGS_DIR"
cat > "$LAB_SETTINGS_DIR/overrides.json" <<'JSON'
{
  "@jupyterlab/docmanager-extension:plugin": {
    "defaultViewers": {
      "markdown": "Markdown Preview"
    }
  }
}
JSON
